# muckscraperHeadlinesGoogleNEW/.env.sample
NEWS_API_KEY=your_newsapi_key_here
GNEWS_API_KEY=your_gnews_key_here
POSTGRES_USER=postgres  # you should probably change this
POSTGRES_PASSWORD=default1 # maybe this one too?
POSTGRES_DB=aggregator # stop being lazy, don't use the defaults!
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_real_admin_password
# Number of gunicorn worker processes for the admin app (default 2). Each is a
# separate process, so a long-running admin action in one worker doesn't
# freeze requests being served by the others.
GUNICORN_WORKERS=2
OLLAMA_HOST=http://your_ollama_ip:11434
# Optional: a second Ollama host used automatically when OLLAMA_HOST is
# unreachable (e.g. an always-on CPU box covering for a Wake-on-LAN GPU box).
# Must serve the same OLLAMA_MODEL / EMBEDDING_MODEL. Leave blank to disable.
OLLAMA_FALLBACK_HOST=
# Optional: seconds to serve from the fallback before re-probing the primary
# so it is picked back up automatically once it comes online (default 60).
OLLAMA_PRIMARY_RECHECK_SECONDS=60
OLLAMA_MODEL=your_model_name_here
SECRET_KEY=generate_with_python3_-c_import_secrets_print_secrets.token_hex_32
EMBEDDING_MODEL=your_model_name_here # suggest nomic-embed-text
# Provider toggle: "ollama" (default, home machine), "gemini", or "groq"
# (e.g. running on a VPS while Ollama is unreachable). Flip both back to
# "ollama" once Ollama is reachable again -- no code changes needed.
# Note: Groq has no embedding models, so EMBEDDING_PROVIDER must stay
# "ollama" or "gemini" even when LLM_PROVIDER=groq.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
# Default request timeout (seconds) for short LLM calls - classification, bias
# rating, story grouping, headline generation. Raise this for slower backends
# (local large model, Ollama Cloud) so short calls don't time out and silently
# degrade quality. Callers with longer prompts (summarizer) use their own
# explicit timeouts and ignore this. See issue #1.
LLM_TIMEOUT=60
# Required only when LLM_PROVIDER or EMBEDDING_PROVIDER is "gemini":
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Required only when LLM_PROVIDER is "groq":
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# GNews locale. Defaults to de/de for this DE downstream so GNews pulls German
# news instead of the upstream hardcoded US/EN. Override per-topic via the
# fetch_and_store_articles gnews_country/gnews_lang args. See GNews-Config-Bug.
GNEWS_COUNTRY=de
GNEWS_LANG=de
# NewsAPI locale. Defaults to de/de for this DE downstream so NewsAPI pulls
# German news instead of the upstream hardcoded US/EN. /everything (query
# mode) uses NEWSAPI_LANGUAGE (no country support); /top-headlines (top mode)
# uses NEWSAPI_COUNTRY. See NewsAPI-Config-Bug (analog to GNews-Config-Bug).
NEWSAPI_COUNTRY=de
NEWSAPI_LANGUAGE=de
# Dev throttle. Set DEV_MODE=1 while developing/verifying to spare free-tier
# API limits: NewsAPI page_size 100 -> 5, GNews max 20 -> 3, scheduler fetches
# only the first active topic and skips the startup fetch. Leave empty/0 for
# normal production runs. See Dev-Drosselung-Plan.
DEV_MODE=
# LLM output locale. Prepended as "Respond in <lang>." to every text-generation
# prompt so headlines/summaries/analysis come back in this language even though
# the upstream prompts are English. Default "de" for this DE downstream. Set
# empty for upstream (English) behavior. Structured callers (grouper number,
# classifier topic-name list) are unaffected. See LLM-Output-Locale directive.
LLM_OUTPUT_LANG=de
FETCH_SCHEDULE_HOURS=7,12,17,22
FULL_PIPELINE_HOURS=7,17
# Optional: set this if Ollama is on another machine and you use wake-on-LAN.
OLLAMA_MAC=
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=replace_with_a_real_meilisearch_key
