# muckscraperHeadlinesGoogleNEW/.env.sample
NEWS_API_KEY=your_newsapi_key_here
GNEWS_API_KEY=your_gnews_key_here
POSTGRES_USER=postgres  # you should probably change this
POSTGRES_PASSWORD=default1 # maybe this one too?
POSTGRES_DB=aggregator # stop being lazy, don't use the defaults!
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_real_admin_password
# Number of gunicorn worker processes for the admin app (default 2). Each is a
# separate process, so a long-running admin action in one worker doesn't
# freeze requests being served by the others.
GUNICORN_WORKERS=2
OLLAMA_HOST=http://your_ollama_ip:11434
# Optional: a second Ollama host used automatically when OLLAMA_HOST is
# unreachable (e.g. an always-on CPU box covering for a Wake-on-LAN GPU box).
# Must serve the same OLLAMA_MODEL / EMBEDDING_MODEL. Leave blank to disable.
OLLAMA_FALLBACK_HOST=
# Optional: seconds to serve from the fallback before re-probing the primary
# so it is picked back up automatically once it comes online (default 60).
OLLAMA_PRIMARY_RECHECK_SECONDS=60
OLLAMA_MODEL=your_model_name_here
# Optional: a smaller/faster model for the pipeline's high-volume mechanical
# calls -- story-grouping confirmation, topic classification, headline
# generation, outlet bias. A full run makes ~1,100 of those against ~65
# summary/deep-report calls, which stay on OLLAMA_MODEL regardless. Biggest win
# when OLLAMA_MODEL is too large to fit your GPU's VRAM (check `size_vram` vs
# `size` in /api/ps -- a partially-offloaded model runs several times slower).
# Leave blank to use OLLAMA_MODEL for everything.
OLLAMA_FAST_MODEL=
SECRET_KEY=generate_with_python3_-c_import_secrets_print_secrets.token_hex_32
EMBEDDING_MODEL=your_model_name_here # suggest nomic-embed-text
# Provider toggle: "ollama" (default, home machine), "gemini", "groq", or
# "openrouter" (e.g. running on a VPS while Ollama is unreachable). Flip both
# back to "ollama" once Ollama is reachable again -- no code changes needed.
#
# EMBEDDING_PROVIDER can only be "ollama" or "gemini". Groq serves no embedding
# models and OpenRouter routes chat completions only, so setting either here
# quietly falls back to Ollama (with a warning in the logs). Changing embedding
# provider for real is not just a config edit either: vectors from different
# models aren't comparable, so it needs a re-embed of the whole corpus, and a
# migration too if the new model's dimensions differ from the 768 the
# `embedding` column is sized for.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
# Optional: send the fast tier to a different provider than LLM_PROVIDER.
# A run makes ~1,140 fast calls (story grouping, topic classification, outlet
# bias) against ~65 quality ones (summaries, deep reports), so this is how you
# run heavy summarization in the cloud while keeping the high-volume mechanical
# work on a local box:
#
#   LLM_PROVIDER=openrouter      <- summaries and deep reports
#   LLM_FAST_PROVIDER=ollama     <- grouping, classification, bias
#
# Note the ordering reads backwards from "route simple things to Ollama": the
# global is the cloud provider and Ollama is the exception. That is deliberate
# -- it is the only arrangement where an install that only ever set
# LLM_PROVIDER keeps behaving exactly as it does today.
#
# Blank means "same as LLM_PROVIDER" (single-provider behavior, the default).
# Each provider still needs its own key/model vars set below.
LLM_FAST_PROVIDER=
# Required only when LLM_PROVIDER or EMBEDDING_PROVIDER is "gemini":
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Required only when LLM_PROVIDER is "groq". GROQ_MODEL has no default -- Groq
# retires models periodically, so a baked-in name goes stale and 404s on every
# call. Check `curl -H "Authorization: Bearer $GROQ_API_KEY" \
# https://api.groq.com/openai/v1/models` for what is currently served;
# openai/gpt-oss-20b was a reasonable general-purpose choice as of 2026-08.
GROQ_API_KEY=
GROQ_MODEL=
# Required only when LLM_PROVIDER is "openrouter". OPENROUTER_MODEL has no
# default -- leaving it blank reads as "not configured" rather than sending an
# empty model name, so set it to something like "meta-llama/llama-3.1-8b-instruct".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_HOST is the OpenAI-compatible base URL. Point it at any other
# provider speaking that API -- DeepSeek, OpenAI, Together, a local vLLM -- and
# the OPENROUTER_* settings drive it with no code changes.
OPENROUTER_HOST=https://openrouter.ai/api/v1
# Optional, attribution only -- OpenRouter shows these on its public leaderboards.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
# Optional: set this if Ollama is on another machine and you use wake-on-LAN.
OLLAMA_MAC=
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=replace_with_a_real_meilisearch_key
