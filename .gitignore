.env
# Also cover .env backups/variants (.env.bak.*, .env.local, ...) -- only plain
# ".env" was ignored, so a stray backup holding the same secrets could be
# committed by a `git add -A`. .env.sample is the one that must stay tracked.
.env.*
!.env.sample
postgres_data/
meili_data/
.pytest_cache/
__pycache__/
*.pyc
destroy.sh
CLAUDE.md
printouts
.gitignore
.claude
.agents
# Our own tests stay local. Tests that come with contributors' pull
# requests are kept in the repo: un-ignore each one by name.
tests/*
!tests/test_settings_form_ownership.py
!tests/test_ai_task_network_errors.py
!tests/test_navigation_access.py
!tests/test_oidc.py

